# Copier en .env. Ne jamais commiter .env.
ENV=development
DEBUG=true

# Générer une valeur aléatoire longue : python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=480

# SQLite par défaut (aucune dépendance). Postgres en prod :
# DATABASE_URL=postgresql+psycopg://aegis:aegis@localhost:5432/aegis
DATABASE_URL=sqlite:///./aegis.db

# Origines autorisées du frontend (CORS)
CORS_ORIGINS=["http://localhost:5173"]

# Compte admin amorcé au premier démarrage
FIRST_ADMIN_EMAIL=admin@aegis.local
FIRST_ADMIN_PASSWORD=admin1234

# Données de démo (dashboards vivants sans SIEM). Passer à false pour une
# intégration réelle Wazuh/ELK/IA — voir les variables ci-dessous.
DEMO_MODE=true

# ── Elasticsearch / Wazuh (uniquement si DEMO_MODE=false) ────
ES_HOST=https://localhost:9200
ES_USER=
ES_PASS=
WAZUH_HOST=https://localhost
WAZUH_USER=
WAZUH_PASS=
AR_MIN_LEVEL=10

# ── IA — fournisseur : groq | openrouter | deepseek | ollama | openai_compatible ──
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=

# ── Threat Intel : VirusTotal (optionnel) ────────────────────
VT_API_KEY=
